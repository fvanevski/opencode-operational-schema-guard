{
  "schema": "issue75-receipt-get-fencing-audit-v1",
  "audit_timestamp": "2026-11-02T19:44:45Z",
  "vulnerability_analysis": {
    "root_cause": "Prior gate _proxy implementation only checked hold for POST or GET with recover=true. Ordinary GET /api/v1/admin/commit_receipts/{session}/{key} with recover=false was proxied via _proxy_unheld without acquiring admission_hold.publication. The backend get_commit_receipt handler invokes owner.reconcile(allow_recovery=False), which mutates durable state (updating preparing->accepted and completed->sealed_terminal in commit_receipts.sqlite3).",
    "fencing_fix": "Normalized incoming path via posixpath.normpath(urllib.parse.unquote(path.path)). All receipt endpoints (/api/v1/admin/commit_receipts/{session}/{key}) are fenced under admission_hold.publication for all HTTP verbs and all query parameter variants. Pure read-only owner binding lookups (/api/v1/admin/commit_receipts/binding/{session}) and health checks (/health) remain unfenced."
  },
