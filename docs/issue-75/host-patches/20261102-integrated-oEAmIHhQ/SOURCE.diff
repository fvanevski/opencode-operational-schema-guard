+            raise Held('immutable fingerprint mismatch')
+        if canonical_digest(json.loads(intent['commit_body_json']))!=attempt['body_digest']:
+            raise Held('intent body mismatch')
+        if conn.execute("UPDATE intents SET state='dead',last_error='backend_preacceptance_rejected: owner audited' WHERE account=? AND user_id=? AND actor_peer=? AND session_id=?",tuple(intent[k] for k in fields)).rowcount!=1:
+            raise Held('intent count mismatch')
+        if conn.execute('UPDATE commit_attempts SET resolved=1 WHERE request_key=? AND submitted=1 AND resolved=0',(key,)).rowcount!=1:
+            raise Held('attempt count mismatch')
