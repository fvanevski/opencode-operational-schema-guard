+"""Durable default-closed publication hold and owner-only rejection transaction.
+
+No network, scheduler or implicit release. Caller must quiesce services and prove
+backend nonacceptance before repair. A hold transition takes the same publication
+fence exclusively; workers retain a shared fence through terminal processing.
+"""
+from contextlib import contextmanager, closing
+from functools import wraps
+import fcntl
+import hashlib
+import json
+import os
+import sqlite3
+import stat
+import time
+
+class Held(RuntimeError):
+    pass
+
+
+def closed(conn):
+    try:
+        row = conn.execute("SELECT held FROM recovery_hold WHERE singleton=1").fetchone()
+        return row is None or row[0] != 0
+    except sqlite3.DatabaseError:
+        return True
+
+
+def initialize(conn):
+    conn.execute("CREATE TABLE IF NOT EXISTS recovery_hold(singleton INTEGER PRIMARY KEY CHECK(singleton=1), held INTEGER NOT NULL CHECK(held IN (0,1)), owner TEXT NOT NULL, revision INTEGER NOT NULL, reason TEXT NOT NULL)")
+    conn.execute("INSERT OR IGNORE INTO recovery_hold VALUES(1,1,'bootstrap',0,'default closed: owner disposition required')")
+    conn.execute("CREATE TABLE IF NOT EXISTS recovery_hold_audit(id INTEGER PRIMARY KEY, owner TEXT NOT NULL, revision INTEGER UNIQUE NOT NULL, held INTEGER NOT NULL, reason TEXT NOT NULL, at REAL NOT NULL)")
+    conn.execute("CREATE TABLE IF NOT EXISTS rejection_repairs(request_key TEXT PRIMARY KEY, owner TEXT NOT NULL, evidence_digest TEXT NOT NULL, intent_before TEXT NOT NULL, attempt_before TEXT NOT NULL, intent_after TEXT NOT NULL, attempt_after TEXT NOT NULL, at REAL NOT NULL)")
+    # Defend stale/old direct callers as well as the current worker. Missing hold
+    # singleton is closed, never equivalent to open. No trigger auto-releases.
+    test = "COALESCE((SELECT held FROM recovery_hold WHERE singleton=1),1) != 0"
+    for name,table,event,when in [
+        ("hold_intent_claim","intents","UPDATE OF state","NEW.state='inflight'"),
+        ("hold_attempt_submit","commit_attempts","UPDATE OF submitted","NEW.submitted=1 AND OLD.submitted=0"),
+        ("hold_attempt_insert","commit_attempts","INSERT","NEW.submitted=1")]:
+        conn.execute(f"CREATE TRIGGER IF NOT EXISTS {name} BEFORE {event} ON {table} WHEN ({when}) AND ({test}) BEGIN SELECT RAISE(ABORT,'admission held'); END")
+    if conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='memory_work'").fetchone():
+        for event in ("INSERT", "UPDATE OF status"):
+            name="hold_memory_"+("insert" if event=="INSERT" else "update")
+            conn.execute(f"CREATE TRIGGER IF NOT EXISTS {name} BEFORE {event} ON memory_work WHEN NEW.status IN ('admitted','processing') AND ({test}) BEGIN SELECT RAISE(ABORT,'admission held'); END")
+
+
+def owner_file(path):
+    info = os.stat(path, follow_symlinks=False)
+    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
+        raise PermissionError("owner-only regular database required")
+
+
+@contextmanager
+def fence(path, exclusive=False):
+    # Existing parent and database ownership are validated; never replace lock.
+    owner_file(path)
+    flags=os.O_RDWR|os.O_CREAT|os.O_NOFOLLOW
+    fd=os.open(path+".publication.lock",flags,0o600)
+    try:
+        info=os.fstat(fd)
+        if info.st_uid != os.getuid() or info.st_mode & 0o077 or not stat.S_ISREG(info.st_mode):
+            raise PermissionError("unsafe publication fence")
+        try:
+            fcntl.flock(fd,(fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)|fcntl.LOCK_NB)
+        except BlockingIOError as exc:
+            raise Held("publication active or owner transition in progress") from exc
+        yield
+    finally:
+        os.close(fd)
+
+
+@contextmanager
+def publication(path):
+    with fence(path):
+        conn=sqlite3.connect('file:'+path+'?mode=ro',uri=True)
+        try:
+            conn.execute('PRAGMA query_only=ON')
+            if closed(conn):
+                raise Held("durable admission held")
+        finally:
+            conn.close()
+        yield
+
+
+def guarded(default=False):
+    def decorate(fn):
+        @wraps(fn)
+        def wrapper(self,*args,**kwargs):
+            db=getattr(self,'db',None) or self.server.db
+            try:
+                with publication(db.path):
+                    return fn(self,*args,**kwargs)
+            except Held:
+                if hasattr(self,"_set_admission_status"):
+                    self._set_admission_status("durable_hold")
+                return default
+        return wrapper
+    return decorate
+
+
+def set_hold(path, owner, revision, held, reason):
+    if not isinstance(owner,str) or len(owner)<16 or owner=='bootstrap' or not reason:
+        raise ValueError("explicit owner and reason required")
+    with fence(path,exclusive=True), closing(sqlite3.connect(path)) as conn, conn:
+        conn.execute('BEGIN IMMEDIATE')
+        row=conn.execute('SELECT held,owner,revision FROM recovery_hold WHERE singleton=1').fetchone()
+        if row is None or row[2] != revision or row[1] not in (owner,'bootstrap'):
+            raise Held('stale hold owner or revision')
+        if not held and row[1] == 'bootstrap':
+            raise Held('claim hold ownership before release')
+        conn.execute('UPDATE recovery_hold SET held=?,owner=?,revision=revision+1,reason=? WHERE singleton=1',(int(held),owner,reason))
+        conn.execute('INSERT INTO recovery_hold_audit(owner,revision,held,reason,at) VALUES(?,?,?,?,?)',(owner,revision+1,int(held),reason,time.time()))
+        return revision+1
+
+
+def canonical(value):
+    return json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False)
+
+
