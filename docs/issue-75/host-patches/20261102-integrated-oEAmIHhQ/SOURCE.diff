+        attempt=conn.execute('SELECT * FROM commit_attempts WHERE request_key=?',(key,)).fetchone()
+        audit=conn.execute('SELECT * FROM rejection_repairs WHERE request_key=?',(key,)).fetchone()
+        if audit:
