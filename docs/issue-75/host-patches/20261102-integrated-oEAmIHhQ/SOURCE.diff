+            raise Held('exact preimage mismatch')
+        if (intent['state']!='unknown' or intent['task_id'] is not None or attempt['submitted']!=1 or attempt['resolved']!=0
+            or intent['claimed_generation']!=attempt['generation'] or intent['requested_generation']!=attempt['generation']
