+++ b/tmp/opencode/issue81-qual/terminal81-a1f3c9/scratch-evalfix/docs/issue-78/v2-candidate/events.mjs
@@ -82,7 +82,18 @@ function promptText(event) {
   const raw = event?.prompt?.text;
   let text = typeof raw === 'string' ? raw : '';
   if (text.startsWith('"')) {
-    try { const value = JSON.parse(text); text = typeof value === 'string' ? value : ''; }
+    // Native prompt payloads are JSON-encoded strings. Some producers emit
+    // unescaped control characters (raw newlines) inside the wrapper, which
+    // is not strict JSON; escape them before decoding so a multi-line long
+    // user prompt is not lost as a whole. A still-malformed wrapper fails
+    // closed exactly as before.
+    const repair = x => x.replace(/[\u0000-\u001f]/g,
+      c => '\\u' + ('0000' + c.charCodeAt(0).toString(16)).slice(-4));
+    try {
+      try { const value = JSON.parse(text); text = typeof value === 'string' ? value : ''; }
+      catch { const value = JSON.parse(repair(text));
+        text = typeof value === 'string' ? value : ''; }
+    }
     catch { return ''; }
   }
   return text;
