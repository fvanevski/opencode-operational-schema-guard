[Unit]
Description=Admitted post-exit candidate curator
# Do not launch a second model server or Graphiti instance.
# The pre-existing Python gate retains exclusive inference admission.
StartLimitIntervalSec=0

[Service]
Type=oneshot
EnvironmentFile=@@PRIVATE_ENV_FILE@@
ExecStart=@@PYTHON_EXEC@@ @@POST_EXIT_GATE_WRAPPER@@ --gate-source @@INSTALLED_GATE_SOURCE@@ --gate-config @@INSTALLED_GATE_CONFIG@@ --cli @@CURATOR_CLI@@ --group @@GROUP@@ --state-dir @@PRIVATE_STATE_DIR@@ --endpoint @@GRAPHITI_MCP_LOOPBACK@@ --max-seconds 600 --lock-timeout 120
Restart=on-failure
RestartSec=30s
TimeoutStartSec=infinity
NoNewPrivileges=yes
UMask=0077
# Disposable isolated group only. Production install requires separately accepted gate and worker lifecycle.
